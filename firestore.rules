rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "th8Jr2dzCdbBaKQYST1MzQZDG4G3";
    }

    function sharedWith(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.sharedWith;
    }

    function isMappedTo(userId) {
      return request.auth != null
        && request.auth.uid in sharedWith(userId);
    }

    match /users/{userId} {
      allow read: if signedInAs(userId) || isAdmin() || isMappedTo(userId);
      allow create: if signedInAs(userId)
        && request.resource.data.keys().hasOnly(["credentialName", "credentialUpdatedAt"])
        && request.resource.data.credentialName is string
        && request.resource.data.credentialName.size() <= 80;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(["groupIds", "sharedWith", "mappingUpdatedAt", "mappingUpdatedBy"])
        && request.resource.data.groupIds is list
        && request.resource.data.sharedWith is list
        && request.resource.data.mappingUpdatedBy == request.auth.uid;
      allow update: if signedInAs(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["credentialName", "credentialUpdatedAt"])
        && request.resource.data.credentialName is string
        && request.resource.data.credentialName.size() <= 80;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["groupIds", "sharedWith", "mappingUpdatedAt", "mappingUpdatedBy"])
        && request.resource.data.groupIds is list
        && request.resource.data.sharedWith is list
        && request.resource.data.mappingUpdatedBy == request.auth.uid;
      allow delete: if false;

      match /notes/{noteId} {
        allow read: if signedInAs(userId) || isAdmin() || isMappedTo(userId);
        allow delete: if signedInAs(userId);

        allow create: if signedInAs(userId)
          && request.resource.data.visitDate is string
          && request.resource.data.isDraft is bool
          && request.resource.data.transcription is string;

        allow update: if (signedInAs(userId) || isMappedTo(userId))
          && request.resource.data.visitDate is string
          && request.resource.data.isDraft is bool
          && request.resource.data.transcription is string;

        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["adminCopiedAt", "adminCopiedBy"])
          && request.resource.data.adminCopiedBy == request.auth.uid
          && request.resource.data.adminCopiedAt is timestamp;

        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["transcription", "adminEditedAt", "adminEditedBy"])
          && request.resource.data.transcription is string
          && request.resource.data.adminEditedBy == request.auth.uid
          && request.resource.data.adminEditedAt is timestamp;
      }
    }

    match /groups/{groupId} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid in resource.data.memberUids);
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() >= 2
        && request.resource.data.memberUids.size() <= 30
        && request.resource.data.mappingUpdatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /{path=**}/notes/{noteId} {
      allow read: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
