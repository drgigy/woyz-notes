rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "th8Jr2dzCdbBaKQYST1MzQZDG4G3";
    }

    match /users/{userId} {
      allow read, write: if signedInAs(userId);

      match /notes/{noteId} {
        allow read: if signedInAs(userId) || isAdmin();
        allow delete: if signedInAs(userId);

        allow create: if signedInAs(userId)
          && request.resource.data.visitDate is string
          && request.resource.data.isDraft is bool
          && request.resource.data.transcription is string;

        allow update: if signedInAs(userId)
          && request.resource.data.visitDate is string
          && request.resource.data.isDraft is bool
          && request.resource.data.transcription is string;
      }
    }

    match /{path=**}/notes/{noteId} {
      allow read: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
